      "title": "ECS CPU",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "namespace": "AWS/ECS",
          "region": "$region",
          "metricName": "CPUUtilization",
          "statistics": [
            "Average"
